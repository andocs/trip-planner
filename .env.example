# Copy to .env.local and fill in from Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: a URL or email added to the User-Agent of "Find coordinates" requests,
# as OpenStreetMap's Nominatim usage policy asks. Safe to set on Vercel.
GEOCODER_CONTACT=

# Optional, local scripts only. NEVER add these to Vercel or prefix them with NEXT_PUBLIC_.
# The service-role key bypasses Row Level Security (used by `npm run seed -- --token …`).
SUPABASE_SERVICE_ROLE_KEY=
# Base URL printed in the invite link by `npm run seed` (defaults to http://localhost:3000).
APP_URL=
