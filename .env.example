# Supabase (required)
# From: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google Maps (required if using Discover tab)
# Server key: Google Cloud Console → Credentials (keep secret, never share)
GOOGLE_MAPS_SERVER_KEY=your-server-key
# Browser key: Google Cloud Console → Credentials (restricted to your domain)
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=your-browser-key
# Map ID: Google Cloud Console → Maps API → Map ID
NEXT_PUBLIC_GOOGLE_MAP_ID=your-map-id

# Place search identity (optional)
# Identifies your app to OpenStreetMap Nominatim. Example: TripPlanner/1.0 (you@example.com)
NOMINATIM_USER_AGENT=

# Local development only (never add to Vercel)
# From: Project Settings → API → Service role key (includes RLS bypass)
SUPABASE_SERVICE_ROLE_KEY=
# Base URL for invite links in local seed script (defaults to http://localhost:3000)
APP_URL=
